{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kestrel:research:advisory:1",
  "title": "Research-only council advisory; no trading authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "advisory_id", "advisor_id", "spec_version", "spec_sha256", "code_commit", "mode", "influence", "primary_decision_hash", "primary_action", "reference_action", "asset", "decision_at", "computed_at", "latest_event_end", "latest_input_available_at", "expires_at", "signal_direction", "stance", "candidate_signal", "horizon", "rationale_codes", "inputs", "freshness", "evidence", "uncertainty", "regime", "shared_dependencies", "economics", "input_sha256"],
  "properties": {
    "schema_version": {"const": "kestrel-advisory-1"},
    "advisory_id": {"type": "string", "minLength": 1},
    "advisor_id": {"enum": ["C1_BRC", "C2_ECDR"]},
    "spec_version": {"type": "integer", "minimum": 1},
    "spec_sha256": {"$ref": "#/$defs/hash"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mode": {"const": "SHADOW"},
    "influence": {"const": "NONE"},
    "primary_decision_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "primary_action": {"enum": ["NO_TRADE", "LONG_CANDIDATE", "UNKNOWN"]},
    "reference_action": {"const": "PROSPECTIVE_LONG"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "instrument_id", "pool_or_venue", "source", "price_currency", "account_numeraire", "membership_id"],
      "properties": {
        "profile": {"enum": ["equity_daily", "liquid_crypto_1h", "solana_meme_15m"]},
        "instrument_id": {"type": "string"}, "pool_or_venue": {"type": "string"},
        "source": {"type": "string"}, "price_currency": {"type": "string"},
        "account_numeraire": {"type": "string"}, "membership_id": {"type": "string"}
      }
    },
    "decision_at": {"$ref": "#/$defs/time"}, "computed_at": {"$ref": "#/$defs/time"},
    "latest_event_end": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "latest_input_available_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "expires_at": {"$ref": "#/$defs/time"},
    "signal_direction": {"enum": ["LONG", "AGAINST_LONG", "NEUTRAL", "UNKNOWN"]},
    "stance": {"enum": ["SUPPORT", "CAUTION", "OPPOSE", "ABSTAIN"]},
    "candidate_signal": {"type": "object", "propertyNames": {"enum": ["residual_z", "beta", "alpha", "residual_scale", "shock_z", "depth_ratio", "baseline_cost", "event_cost", "recovery_cost1", "recovery_cost2", "target_distance"]}, "additionalProperties": {"anyOf": [{"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}, {"type": "null"}]}, "description": "Only named decimal diagnostics; no probability or expected-return field."},
    "horizon": {"type": "object", "required": ["maximum", "unit"], "properties": {"maximum": {"type": "integer", "minimum": 1}, "unit": {"enum": ["SECONDS", "SESSIONS"]}}, "additionalProperties": false},
    "rationale_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["store", "row_id", "raw_sha256", "event_end", "first_available_at"], "properties": {"store": {"type": "string"}, "row_id": {"type": "string"}, "raw_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "event_end": {"$ref": "#/$defs/time"}, "first_available_at": {"$ref": "#/$defs/time"}}, "additionalProperties": false}},
    "freshness": {"type": "object", "required": ["status", "missing", "stale"], "properties": {"status": {"enum": ["OK", "MISSING", "STALE", "CONFLICT", "UNVERIFIED"]}, "missing": {"type": "array", "items": {"type": "string"}}, "stale": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "evidence": {"type": "object", "required": ["training_bars", "signal_bars", "quote_pairs", "forward_closed_trades", "effective_observations"], "properties": {"training_bars": {"type": "integer", "minimum": 0}, "signal_bars": {"type": "integer", "minimum": 0}, "quote_pairs": {"type": "integer", "minimum": 0}, "forward_closed_trades": {"type": "integer", "minimum": 0}, "effective_observations": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}}, "additionalProperties": false},
    "uncertainty": {"type": "object", "required": ["calibrated", "interval", "reason"], "properties": {"calibrated": {"const": false}, "interval": {"type": "null"}, "reason": {"type": "string"}}, "additionalProperties": false},
    "regime": {"type": "object", "required": ["status", "label"], "properties": {"status": {"type": "string"}, "label": {"type": ["string", "null"]}}, "additionalProperties": false},
    "shared_dependencies": {"type": "array", "items": {"type": "string"}},
    "economics": {"type": "object", "required": ["status", "ticket_raw", "roundtrip_cost_fraction", "expected_net_return"], "properties": {"status": {"enum": ["UNVALIDATED", "UNMEASURED", "CURRENT_COST_QUALIFIED_ONLY", "FAILED_CURRENT_COST"]}, "ticket_raw": {"type": ["string", "null"], "pattern": "^[0-9]+$"}, "roundtrip_cost_fraction": {"type": ["string", "null"]}, "expected_net_return": {"type": "null"}}, "additionalProperties": false},
    "input_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "description": "JSON validation is necessary but not sufficient: application checks must enforce timestamp inequalities, expiry, input hash, stance gating, units, exact quantities, and immutable provenance. This contract forbids trading influence and calibrated probability claims."
}
